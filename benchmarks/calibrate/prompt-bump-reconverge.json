{
  "version": 1,
  "role": "calibrate",
  "model_version": "beta-binomial-v1",
  "prompt_version": "memory-promote-v2",
  "scope": {"kind": "project", "id": "aimee"},
  "inputs": {
    "target_surface": "memory",
    "kind": "fact",
    "buckets": [
      {"range": [0.7, 0.8], "n_accepted": 5, "n_rejected": 4},
      {"range": [0.8, 0.9], "n_accepted": 12, "n_rejected": 3},
      {"range": [0.9, 1.0], "n_accepted": 15, "n_rejected": 1}
    ],
    "conformal_window": [
      {"applied_confidence": 0.72, "verdict": "rejected"},
      {"applied_confidence": 0.80, "verdict": "accepted"},
      {"applied_confidence": 0.86, "verdict": "accepted"},
      {"applied_confidence": 0.89, "verdict": "rejected"},
      {"applied_confidence": 0.95, "verdict": "accepted"}
    ],
    "config": {
      "prior_alpha0": 2.0,
      "prior_beta0": 1.0,
      "buckets": 10,
      "credible_delta": 0.10,
      "conformal_window_size": 500,
      "conformal_epsilon": 0.05
    }
  }
}
