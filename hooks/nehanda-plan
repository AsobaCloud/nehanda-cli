#!/usr/bin/env bash
# hooks/nehanda-plan
# Plan management CLI for nehanda-cli sessions.
#
# Usage:
#   nehanda-plan start           Create a new plan draft
#   nehanda-plan approve         Approve the current draft (enables editing)
#   nehanda-plan status          Show current plan state
#   nehanda-plan show            Print the current plan content
#   nehanda-plan clear           Clear all plan state (use after task is done)
#
# Install (done by install.sh):
#   cp hooks/nehanda-plan ~/.local/bin/nehanda-plan
#   chmod +x ~/.local/bin/nehanda-plan

set -euo pipefail
HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOKS_DIR/common.sh"

# Init without reading stdin (this is a CLI command, not a hook)
ensure_db
SESSION_ID="${SESSION_ID:-}"
if [[ -z "$SESSION_ID" ]]; then
    phash="$(pwd | shasum | cut -c1-12)"
    SESSION_ID="nehanda-${phash}-$(date +%Y%m%d)"
fi
CONV_ID="$SESSION_ID"
db_exec "INSERT OR IGNORE INTO conversations (id, project_dir) VALUES (?, ?);" "$CONV_ID" "$(pwd)"
db_exec "INSERT OR IGNORE INTO sessions (session_id, conversation_id) VALUES (?, ?);" "$SESSION_ID" "$CONV_ID"

PLAN_DIR="${NEHANDA_PROJECT_DIR:-$(pwd)}/.nehanda/plans"
PLAN_FILE="$PLAN_DIR/current.md"

case "${1:-help}" in
# ── start ────────────────────────────────────────────────────────────────────
start)
    # Clear existing approval state
    for key in approved plan_file plan_hash scope criteria objective \
                objective_verification objective_verification_required \
                planning dirty validated validated_unit validated_e2e \
                tests_failed tests_reviewed edit_count validation_complete; do
        state_remove "$key" 2>/dev/null || true
    done
    db_exec "DELETE FROM plans WHERE conversation_id=? AND status='draft';" "$CONV_ID"

    state_write planning "1"
    state_write planning_started_at "$(date +%s)"
    mkdir -p "$PLAN_DIR"

    # Write plan template if file doesn't exist
    if [[ ! -f "$PLAN_FILE" ]]; then
        cat > "$PLAN_FILE" << 'TEMPLATE'
# Plan

## Objective
<!-- What needs to be accomplished. One or two sentences. -->

## Scope
<!-- List every file that will be modified, one per line as absolute paths:
- /absolute/path/to/file.py
- /absolute/path/to/other.ts
-->

## Success Criteria
<!-- How will you know this is done? -->

## Implementation Plan
<!-- Step-by-step approach -->

## Objective Verification
<!-- The exact command to run to verify this works end-to-end -->
TEMPLATE
        echo "✓ Plan template created: $PLAN_FILE"
    else
        echo "✓ Existing plan found: $PLAN_FILE"
    fi

    save_plan "$PLAN_FILE" "$(cat "$PLAN_FILE")" "draft"
    echo "  Edit the plan, then run: nehanda-plan approve"
    ;;

# ── approve ──────────────────────────────────────────────────────────────────
approve)
    [[ -f "$PLAN_FILE" ]] || { echo "✗ No plan file at $PLAN_FILE — run: nehanda-plan start" >&2; exit 1; }
    CONTENT="$(cat "$PLAN_FILE")"

    # Validate required sections
    MISSING=""
    echo "$CONTENT" | grep -qiE '^##\s+Objective'          || MISSING+="  - ## Objective\n"
    echo "$CONTENT" | grep -qiE '^##\s+Scope'               || MISSING+="  - ## Scope\n"
    echo "$CONTENT" | grep -qiE '^##\s+Success.*Criteria'   || MISSING+="  - ## Success Criteria\n"
    echo "$CONTENT" | grep -qiE '^##\s+Objective.*Verif'    || MISSING+="  - ## Objective Verification\n"

    if [[ -n "$MISSING" ]]; then
        echo "✗ Plan is missing required sections:" >&2
        printf "%b" "$MISSING" >&2
        exit 1
    fi

    # Extract sections
    OBJECTIVE="$(echo "$CONTENT" | sed -n '/^##[[:space:]]*[Oo]bjective/,/^##/p' \
        | tail -n +2 | grep -v '^##' | sed '/^[[:space:]]*$/d' | head -3)"
    SCOPE="$(echo "$CONTENT" | sed -n '/^##[[:space:]]*[Ss]cope/,/^##/p' \
        | tail -n +2 | grep -v '^##' | grep -E '^\s*-\s+/' \
        | sed 's/^[[:space:]]*-[[:space:]]*//')"
    CRITERIA="$(echo "$CONTENT" | sed -n '/^##[[:space:]]*[Ss]uccess/,/^##/p' \
        | tail -n +2 | grep -v '^##' | sed '/^[[:space:]]*$/d' | head -5)"
    OBJ_VERIF="$(echo "$CONTENT" | sed -n '/^##[[:space:]]*[Oo]bjective.*[Vv]erif/,/^##/p' \
        | tail -n +2 | grep -v '^##' | sed '/^[[:space:]]*$/d')"

    # Save to DB and write approval state
    PLAN_HASH="$(printf '%s\n' "$CONTENT" | shasum -a 256 | awk '{print $1}')"
    save_plan "$PLAN_FILE" "$CONTENT" "approved"

    state_write plan_file "$(realpath "$PLAN_FILE" 2>/dev/null || echo "$PLAN_FILE")"
    state_write plan_hash "$PLAN_HASH"
    state_write objective "$OBJECTIVE"
    state_write scope "$SCOPE"
    state_write criteria "$CRITERIA"
    state_write objective_verification "$OBJ_VERIF"
    state_write objective_verification_required "$(echo "$SCOPE" | grep -v '\.(md|txt|rst)$' | grep -c '.' || echo 0)"
    state_remove planning
    state_remove planning_started_at
    state_write approved "1"

    echo "✓ Plan approved"
    echo "  Objective: $OBJECTIVE"
    SCOPE_COUNT="$(echo "$SCOPE" | grep -c '.' || echo 0)"
    echo "  Scope: $SCOPE_COUNT file(s)"
    echo ""
    echo "  Start your nehanda session. Edits outside scope will be blocked."
    ;;

# ── status ───────────────────────────────────────────────────────────────────
status)
    DB_STATUS="$(db_query "SELECT status FROM plans WHERE conversation_id=? ORDER BY id DESC LIMIT 1;" "$CONV_ID" 2>/dev/null || true)"
    if state_exists approved 2>/dev/null; then
        echo "✓ APPROVED"
        state_exists objective 2>/dev/null && echo "  Objective: $(state_read objective)"
        state_exists plan_file 2>/dev/null && echo "  Plan:      $(state_read plan_file)"
        state_exists dirty    2>/dev/null && echo "  Dirty:     $(state_read dirty)"
        state_exists tests_failed 2>/dev/null && echo "  TDD state: tests failed (red phase — editing unlocked)"
        state_exists validated 2>/dev/null && echo "  Validated: $(state_read validated)"
    elif state_exists planning 2>/dev/null; then
        echo "📝 PLANNING"
        echo "  Plan file: $PLAN_FILE"
        echo "  Run: nehanda-plan approve"
    else
        echo "○ IDLE — no active plan"
        echo "  Run: nehanda-plan start"
    fi
    ;;

# ── show ─────────────────────────────────────────────────────────────────────
show)
    DB_CONTENT="$(get_plan_content_from_db 2>/dev/null || true)"
    if [[ -n "$DB_CONTENT" ]]; then
        echo "$DB_CONTENT"
    elif [[ -f "$PLAN_FILE" ]]; then
        cat "$PLAN_FILE"
    else
        echo "No plan found. Run: nehanda-plan start" >&2; exit 1
    fi
    ;;

# ── clear ─────────────────────────────────────────────────────────────────────
clear)
    for key in approved plan_file plan_hash scope criteria objective \
                objective_verification objective_verification_required \
                planning dirty validated validated_unit validated_e2e \
                tests_failed tests_reviewed edit_count validation_complete \
                validation_log; do
        state_remove "$key" 2>/dev/null || true
    done
    echo "✓ Plan state cleared"
    ;;

# ── help ──────────────────────────────────────────────────────────────────────
help|*)
    cat << 'HELP'
nehanda-plan — plan enforcement for nehanda-cli sessions

Commands:
  start    Create a plan draft (.nehanda/plans/current.md)
  approve  Validate and approve the plan (enables editing)
  status   Show current plan/TDD state
  show     Print current plan content
  clear    Clear all state (run after task is complete)

Workflow:
  1. nehanda-plan start       # create plan template
  2. edit .nehanda/plans/current.md
  3. nehanda-plan approve     # approve it
  4. nehanda                  # start session — edits are now gated
  5. nehanda-plan clear       # done
HELP
    ;;
esac
