<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nehanda.kb</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/nehanda-kb</string>
        <string>--http-port=8741</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/postgresql@17/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AIMEE_LLM_URL</key>
        <string>http://127.0.0.1:8742</string>
        <key>AIMEE_EMBEDDING_DIM</key>
        <string>1024</string>
        <key>DATABASE_URL</key>
        <string>postgresql://localhost/aimee_shared</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/nehanda/kb.out</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/nehanda/kb.err</string>
    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
