<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nehanda.embedder</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/scripts/start-embedder.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/postgresql@17/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>NEHANDA_DATA_DIR</key>
        <string>__HOME__/.local/share/nehanda-cli</string>
        <key>AIMEE_LLM_STUB</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/nehanda/embedder.out</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/nehanda/embedder.err</string>
    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
