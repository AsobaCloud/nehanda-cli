<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aimee.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/aimee-server</string>
        <string>--socket=__HOME__/.config/aimee/aimee.sock</string>
    </array>
    <key>RunAtLoad</key>      <true/>
    <key>KeepAlive</key>      <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/aimee/aimee-server.out</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/aimee/aimee-server.err</string>
    <key>ProcessType</key>    <string>Standard</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key><integer>65536</integer>
    </dict>
</dict>
</plist>
