<!--
WinSW service definition for aimee-server.

Run install.ps1 to install aimee-server as a Windows service automatically.
The schtasks fallback below is for portable installs only.

PowerShell scheduled-task alternative (no WinSW):
  schtasks /Create /TN "aimee-server" /SC ONLOGON /RL LIMITED /F ^
    /TR "\"%LOCALAPPDATA%\aimee\bin\aimee-server.exe\" --foreground"
-->
<service>
  <id>aimee-server</id>
  <name>aimee Server</name>
  <description>aimee agent memory and MCP server</description>
  <executable>%BASE%\aimee-server.exe</executable>
  <arguments>--service</arguments>
  <startmode>Automatic</startmode>
  <stoptimeout>15sec</stoptimeout>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <keepFiles>14</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
  <resetfailure>1 hour</resetfailure>
</service>
