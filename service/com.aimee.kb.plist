<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aimee.kb</string>
    <key>ProgramArguments</key>
    <array>
        <!-- aimee-kb serves the /v1 HTTP API only (the legacy --socket transport
             was retired, #2747). It binds 127.0.0.1:8741 by default; point the
             local aimee-server at it with AIMEE_KB_API_URL=http://127.0.0.1:8741. -->
        <string>__HOME__/.local/bin/aimee-kb</string>
        <string>--http-port=8741</string>
    </array>
    <key>RunAtLoad</key>      <true/>
    <key>KeepAlive</key>      <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/aimee/aimee-kb.out</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/aimee/aimee-kb.err</string>
    <key>ProcessType</key>    <string>Standard</string>
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key><integer>65536</integer>
    </dict>
</dict>
</plist>
