+static char *openai_get_effective_system_prompt(const char *prompt)
+{
+   char *pi_env = gw_memory_system_prompt(prompt);
+
+   /* Load the webchat system prompt override if it exists */
+   char sys_path[MAX_PATH_LEN];
+   snprintf(sys_path, sizeof(sys_path), "%s/webchat_system_prompt.txt", config_default_dir());
+
+   dstr_t s;
+   dstr_init(&s);
+   char *webchat_prompt = NULL;
+   if (dstr_read_file(&s, sys_path) == 0 && s.len > 0)
+   {
+      webchat_prompt = dstr_steal(&s);
+   }
+   dstr_free(&s);
+
+   if (!webchat_prompt)
+   {
+      return pi_env;
+   }
+
+   if (pi_env && pi_env[0])
+   {
+      size_t cap = strlen(webchat_prompt) + strlen(pi_env) + 4;
+      char *combined = malloc(cap);
+      if (combined)
+      {
+         snprintf(combined, cap, "%s\n\n%s", webchat_prompt, pi_env);
+         free(webchat_prompt);
+         free(pi_env);
+         return combined;
+      }
+   }
+
+   free(pi_env);
+   return webchat_prompt;
+}
