+  * previous_response_id. Bounds memory and the prompt we feed back to the agent. */
+ #define OPENAI_RESP_TRANSCRIPT_MAX (32 * 1024)
+ 
++/* Helper to inspect whether the incoming request payload contains client-defined tools */
++static int request_has_client_tools(const char *body)
++{
++   if (!body || !body[0])
++      return 0;
++
++   cJSON *root = cJSON_Parse(body);
++   if (!root)
++      return 0;
++
++   cJSON *jtools = cJSON_GetObjectItemCaseSensitive(root, "tools");
++   int has_tools = (jtools && cJSON_IsArray(jtools) && cJSON_GetArraySize(jtools) > 0);
++   cJSON_Delete(root);
++   return has_tools;
++}
++
+ /* Record a dedup cache hit as a non-billable usage_kind=avoided audit row: the
+  * provider call was skipped, so the avoided estimated cost is logged separately
+  * and never added to spend totals (see db1_token_audit_spend_breakdown). Tokens
+@@ -261,7 +277,8 @@ static int run_completion(int chat, const char *body, char *resp, int cap)
+    }
+    else
+    {
+-      erc = agent_execute(ag, pi_env, prompt, max_tokens, temperature, &result);
++      int has_tools = request_has_client_tools(body);
++      erc = has_tools ? agent_execute(ag, pi_env, prompt, max_tokens, temperature, &result) : agent_execute_with_tools(ag, NULL, pi_env, prompt, max_tokens, temperature, &result);
+    }
+    free(pi_env);
+    free(prompt);
+@@ -660,7 +677,8 @@ static int responses_handler(const char *body, char *resp, int cap)
+    /* P1 pre-injection: prepend the <aimee-context> envelope as the system
+     * prompt (config ingress_preinject_enabled; no-op when off/empty). */
+    char *pi_env = gw_memory_system_prompt(full);
+-   int erc = agent_execute(ag, pi_env, full, max_tokens, temperature, &result);
++   int has_tools = request_has_client_tools(body);
++   int erc = has_tools ? agent_execute(ag, pi_env, full, max_tokens, temperature, &result) : agent_execute_with_tools(ag, NULL, pi_env, full, max_tokens, temperature, &result);
+    free(pi_env);
+ 
+    if (erc != 0 || !result.response)
+@@ -793,7 +811,8 @@ static int chat_stream_handler(const char *body, server_http_sse_emit emit, void
+    }
+    else
+    {
+-      erc = agent_execute(ag, pi_env, prompt, max_tokens, temperature, &result);
++      int has_tools = request_has_client_tools(body);
++      erc = has_tools ? agent_execute(ag, pi_env, prompt, max_tokens, temperature, &result) : agent_execute_with_tools(ag, NULL, pi_env, prompt, max_tokens, temperature, &result);
