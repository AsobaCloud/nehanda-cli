+/* Extract image attachments from a parsed OpenCode message body.
+ * Walks the "parts" array for {"type":"file","mediaType":"image/...","data":"<b64>"}
+ * and builds "data:<mediaType>;base64,<data>" strings.
+ * Returns a heap-allocated NULL-terminated array on success (caller frees each
+ * entry and the array), or NULL when no images are present. */
+char **opencode_v2_extract_images(cJSON *root, int *count_out)
+{
+   if (count_out)
+      *count_out = 0;
+   if (!root)
+      return NULL;
+
+   cJSON *parts = cJSON_GetObjectItemCaseSensitive(root, "parts");
+   if (!cJSON_IsArray(parts))
+      parts = cJSON_GetObjectItemCaseSensitive(root, "content");
+   if (!cJSON_IsArray(parts))
+      return NULL;
+
+   /* First pass: count image parts.
+    * OpenCode 1.x sends {"type":"file","mime":"image/...","url":"data:..."}.
+    * Older/mock paths send {"type":"file","mediaType":"image/...","data":"..."}.
+    * Accept both. */
+   int n = 0;
+   cJSON *part = NULL;
+   cJSON_ArrayForEach(part, parts)
+   {
+      cJSON *type = cJSON_GetObjectItemCaseSensitive(part, "type");
+      if (!cJSON_IsString(type) || strcmp(type->valuestring, "file") != 0)
+         continue;
+      /* mediaType (old) or mime (OpenCode 1.x) */
+      cJSON *mt = cJSON_GetObjectItemCaseSensitive(part, "mediaType");
+      if (!cJSON_IsString(mt))
+         mt = cJSON_GetObjectItemCaseSensitive(part, "mime");
+      if (cJSON_IsString(mt) && strncmp(mt->valuestring, "image/", 6) == 0)
+         n++;
+   }
+   if (n == 0)
+      return NULL;
+
+   char **arr = calloc((size_t)(n + 1), sizeof(char *));
+   if (!arr)
+      return NULL;
+
+   /* Second pass: build data-URL strings */
+   int idx = 0;
+   cJSON_ArrayForEach(part, parts)
+   {
+      if (idx >= n)
+         break;
+      cJSON *type = cJSON_GetObjectItemCaseSensitive(part, "type");
+      if (!cJSON_IsString(type) || strcmp(type->valuestring, "file") != 0)
+         continue;
+
+      /* mediaType (old) or mime (OpenCode 1.x) */
+      cJSON *mt = cJSON_GetObjectItemCaseSensitive(part, "mediaType");
+      if (!cJSON_IsString(mt))
+         mt = cJSON_GetObjectItemCaseSensitive(part, "mime");
+      if (!cJSON_IsString(mt) || strncmp(mt->valuestring, "image/", 6) != 0)
+         continue;
+
+      /* data (old) or url (OpenCode 1.x) */
+      cJSON *data = cJSON_GetObjectItemCaseSensitive(part, "data");
+      if (!data)
+         data = cJSON_GetObjectItemCaseSensitive(part, "url");
+
+      const char *media = mt->valuestring;
+      const char *data_str = cJSON_IsString(data) ? data->valuestring : NULL;
+
+      if (!data_str && cJSON_IsObject(data))
+      {
+         /* Bun Uint8Array serialized as {"0":N,...} — decode and base64-encode */
+         int byte_count = cJSON_GetArraySize(data);
+         if (byte_count <= 0 || byte_count > 64 * 1024 * 1024)
+            continue;
+         unsigned char *raw = malloc((size_t)byte_count);
+         if (!raw)
+            continue;
+         int valid = 1;
+         for (int bi = 0; bi < byte_count && valid; bi++)
+         {
+            char key[24];
+            snprintf(key, sizeof(key), "%d", bi);
+            cJSON *bval = cJSON_GetObjectItemCaseSensitive(data, key);
+            if (!cJSON_IsNumber(bval) || bval->valueint < 0 || bval->valueint > 255)
+            { valid = 0; break; }
+            raw[bi] = (unsigned char)bval->valueint;
+         }
+         if (!valid) { free(raw); continue; }
+         size_t b64_len = aimee_base64_encoded_len((size_t)byte_count);
+         char *b64_buf  = malloc(b64_len);
+         if (!b64_buf) { free(raw); continue; }
+         aimee_base64_encode(raw, (size_t)byte_count, b64_buf, b64_len);
+         free(raw);
+         size_t url_len = 5 + strlen(media) + 8 + strlen(b64_buf) + 1;
+         arr[idx] = malloc(url_len);
+         if (arr[idx]) { snprintf(arr[idx], url_len, "data:%s;base64,%s", media, b64_buf); idx++; }
+         free(b64_buf);
+         continue;
+      }
+
+      if (!data_str || !data_str[0])
+         continue;
+
+      /* Already a data: URI — pass through unchanged */
+      if (strncmp(data_str, "data:", 5) == 0)
+      {
+         arr[idx] = strdup(data_str);
+      }
+      else
+      {
+         /* Plain base64 string — build data URI */
+         size_t url_len = 5 + strlen(media) + 8 + strlen(data_str) + 1;
+         arr[idx] = malloc(url_len);
+         if (arr[idx])
+            snprintf(arr[idx], url_len, "data:%s;base64,%s", media, data_str);
+      }
+      if (arr[idx])
+         idx++;
+   }
+
+   if (idx == 0)
+   {
+      free(arr);
+      return NULL;
+   }
+   if (count_out)
+      *count_out = idx;
+   return arr;
+}
+
 char *opencode_v2_extract_prompt(const char *body)
 {
    cJSON *root = cJSON_Parse(body && body[0] ? body : "{}");
