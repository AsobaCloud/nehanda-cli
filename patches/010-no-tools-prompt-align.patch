@@ -298,6 +298,7 @@ static void test_agent_exec_context_truncates_large_prompt(void)
    memset(&ag, 0, sizeof(ag));
    snprintf(ag.name, sizeof(ag.name), "test-agent");
    snprintf(ag.model, sizeof(ag.model), "test-model");
+   ag.tools_enabled = 1;
 
    char *ctx = agent_build_exec_context(&ag, NULL, prompt);
    assert(ctx != NULL);
@@ -339,6 +340,37 @@ static void test_agent_exec_context_ex_can_skip_kb(void)
    teardown();
 }
 
+static void test_agent_exec_context_respects_tools_enabled(void)
+{
+   setup();
+   setenv("AIMEE_CONTEXT_NO_KB", "1", 1);
+
+   agent_t ag;
+   memset(&ag, 0, sizeof(ag));
+   snprintf(ag.name, sizeof(ag.name), "test-agent");
+   snprintf(ag.model, sizeof(ag.model), "test-model");
+
+   /* tools_enabled defaults false — must not force tool invocation */
+   char *off = agent_build_exec_context(&ag, NULL, "plan a demo customer");
+   assert(off != NULL);
+   assert(strstr(off, "You are an execution agent") == NULL);
+   assert(strstr(off, "Always invoke tools") == NULL);
+   assert(strstr(off, "without live tool access") != NULL);
+   assert(strstr(off, "Do not emit tool calls") != NULL);
+   free(off);
+
+   ag.tools_enabled = 1;
+   char *on = agent_build_exec_context(&ag, NULL, "plan a demo customer");
+   assert(on != NULL);
+   assert(strstr(on, "You are an execution agent") != NULL);
+   assert(strstr(on, "Always invoke tools") != NULL);
+   assert(strstr(on, "without live tool access") == NULL);
+   free(on);
+
+   unsetenv("AIMEE_CONTEXT_NO_KB");
+   teardown();
+}
+
 static void test_agent_context_budget_uses_context_window(void)
 {
    agent_t ag;
@@ -371,6 +403,7 @@ int main(void)
    test_task_type_name_strings();
    test_agent_exec_context_truncates_large_prompt();
    test_agent_exec_context_ex_can_skip_kb();
+   test_agent_exec_context_respects_tools_enabled();
    test_agent_context_budget_uses_context_window();
    printf("context_assembly: all tests passed\n");
    return 0;
