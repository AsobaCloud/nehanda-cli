diff --git a/src/server/agent_runtime.c b/src/server/agent_runtime.c
index 4bcfa193..4611a1f6 100644
--- a/src/server/agent_runtime.c
+++ b/src/server/agent_runtime.c
@@ -1469,7 +1469,7 @@ char *agent_build_exec_context_ex(const agent_t *agent, const agent_network_t *n
       aimee_log(LOG_DEBUG, "agent_context", "context assembly: task_type=%s",
                 task_type_name(task_type));
 
