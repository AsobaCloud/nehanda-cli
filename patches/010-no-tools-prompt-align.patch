+   /* Default execution instructions (tools-on agents only) */
    static const char *default_exec_instructions =
        "# Instructions\n"
        "- Use the bash tool to run commands, including SSH to remote hosts.\n"
@@ -1482,6 +1482,18 @@ char *agent_build_exec_context_ex(const agent_t *agent, const agent_network_t *n
        "- When you have completed the task, respond with a final summary.\n"
        "- If you encounter an error, try to diagnose and fix it.\n"
        "- Do not ask for confirmation. Execute the task directly.\n";
+   /* Nehanda/vLLM and other --no-tools agents: never instruct tool use. Doing so
+    * makes the model emit fake list_files/bash blocks that nothing executes, so
+    * OpenCode turns stall after one hallucinated "tool" and require manual continue. */
+   static const char *default_no_tools_instructions =
+       "# Instructions\n"
+       "- You do not have callable tools in this session.\n"
+       "- Do not emit tool calls, fake shell blocks, or pretend to run list_files/bash/"
+       "read_file/write_file.\n"
+       "- Answer from conversation context, attached text/images, and docs the user shares.\n"
+       "- If you need filesystem or command output, ask the user to provide it.\n"
+       "- Prefer a concrete plan or answer in one response instead of stepwise fake tool use.\n";
+   int tools_on = agent && agent->tools_enabled;
    size_t content_budget = agent_exec_context_budget_chars(agent);
    size_t cap = content_budget + 4096; /* extra room for headers */
    char *buf = malloc(cap);
@@ -1512,13 +1512,19 @@ char *agent_build_exec_context_ex(const agent_t *agent, const agent_network_t *n
    int skip_kb_client =
        skip_kb_context || (skip_kb_env && skip_kb_env[0] && strcmp(skip_kb_env, "0") != 0);
 
-   ctx_appendf(buf, cap, &pos,
-               "You are an execution agent. Complete the task using the provided tools.\n"
-               "IMPORTANT: Always invoke tools (bash, read_file, write_file, "
-               "list_files) to act. Never write shell commands or code as plain "
-               "text — call the tool instead.\n"
-               "Use Aimee index/search tools for discovery. Treat current source as the "
-               "file-content authority when it differs from indexed snippets.\n");
+   if (tools_on)
+      ctx_appendf(buf, cap, &pos,
+                  "You are an execution agent. Complete the task using the provided tools.\n"
+                  "IMPORTANT: Always invoke tools (bash, read_file, write_file, "
+                  "list_files) to act. Never write shell commands or code as plain "
+                  "text — call the tool instead.\n"
+                  "Use Aimee index/search tools for discovery. Treat current source as the "
+                  "file-content authority when it differs from indexed snippets.\n");
+   else
+      ctx_appendf(buf, cap, &pos,
+                  "You are a helpful assistant without live tool access in this session.\n"
+                  "Do not pretend to call tools (bash, list_files, read_file, write_file).\n"
+                  "Do not write fake tool-call or shell blocks.\n");
    ctx_appendf(buf, cap, &pos, "%s", prompt_principles_text(config_current_mode()));
 
    char cwd_buf[MAX_PATH_LEN];
@@ -2057,9 +2057,11 @@ char *agent_build_exec_context_ex(const agent_t *agent, const agent_network_t *n
    }
 
    /* Instructions */
-   ctx_appendf(buf, cap, &pos, "%s",
-               agent->exec_system_prompt[0] ? agent->exec_system_prompt
-                                            : default_exec_instructions);
+   if (agent && agent->exec_system_prompt[0])
+      ctx_appendf(buf, cap, &pos, "%s", agent->exec_system_prompt);
+   else
+      ctx_appendf(buf, cap, &pos, "%s",
+                  tools_on ? default_exec_instructions : default_no_tools_instructions);
 
    return buf;
 }
diff --git a/src/tests/test_context_assembly.c b/src/tests/test_context_assembly.c
