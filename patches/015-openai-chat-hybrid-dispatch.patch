+/* Helper to inspect whether the incoming request payload contains client-defined tools */
+static int request_has_client_tools(const char *body)
+{
+   if (!body || !body[0])
+      return 0;
+
+   cJSON *root = cJSON_Parse(body);
+   if (!root)
+      return 0;
+
+   cJSON *jtools = cJSON_GetObjectItemCaseSensitive(root, "tools");
+   int has_tools = (jtools && cJSON_IsArray(jtools) && cJSON_GetArraySize(jtools) > 0);
+   cJSON_Delete(root);
+   return has_tools;
+}
