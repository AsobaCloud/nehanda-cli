{
  "name": "JsSafetyChecker",
  "description": "Run the JavaScript safety checker (AST-based duplicate function, duplicate HTML ID, syntax errors) against a file or directory. Returns findings.",
  "input_schema": {
    "type": "object",
    "properties": {
      "target": { "type": "string", "description": "Target directory to scan (default: cwd)" },
      "timeout": { "type": "integer", "description": "Timeout in ms (max 600000)" }
    }
  },
  "phases": {
    "explore_only": true,
    "planning_blocked": false
  },
  "execution": {
    "runtime": "node",
    "script": "lib/scripts/js-safety-checker.cjs",
    "args": [
      "{{target}}"
    ],
    "default_timeout": 120000,
    "max_timeout": 600000
  }
}
